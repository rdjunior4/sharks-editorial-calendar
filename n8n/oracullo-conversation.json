                  {
                      "parameters":  {
                                         "jsCode":  "// Prepara o envio da resposta: audio (audio_url) ou texto\nconst brain = $json;\nif (!brain.ok || !brain.reply) { throw new Error(\u0027Sem resposta do cerebro\u0027); }\nconst webhook = $(\u0027Evolution Webhook\u0027).first().json;\nconst data = webhook.data ?? {};\nconst number = String(data.key?.remoteJid ?? \u0027\u0027).replace(/@s\\.whatsapp\\.net|@g\\.us/g, \u0027\u0027).replace(/\\D/g, \u0027\u0027);\nconst base = { number };\nif (brain.audio_url) {\n  const res = await fetch(String(brain.audio_url));\n  if (res.ok) {\n    const buf = Buffer.from(await res.arrayBuffer());\n    return [{ json: { ...base, mode: \u0027audio\u0027, audio: \u0027data:audio/mpeg;base64,\u0027 + buf.toString(\u0027base64\u0027), reply: brain.reply, lead_id: brain.lead_id } }];\n  }\n}\nreturn [{ json: { ...base, mode: \u0027text\u0027, reply: brain.reply, lead_id: brain.lead_id } };]"
                                     },
