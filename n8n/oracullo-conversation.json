                  {
                      "parameters":  {
                                         "jsCode":  "// Normaliza a mensagem do WhatsApp (Evolution v2): grupo=invalida, extrai telefone/texto/mid\nconst evt = $json.body ?? {};\nconst data = evt.data ?? {};\nconst remoteJid = String(data.key?.remoteJid ?? \u0027\u0027);\nconst isGroup = remoteJid.endsWith(\u0027@g.us\u0027);\nconst phone = remoteJid.replace(/@s\\.whatsapp\\.net|@g\\.us/g, \u0027\u0027).replace(/\\D/g, \u0027\u0027);\nconst text = String(data.message?.conversation ?? data.message?.extendedTextMessage?.text ?? data.message?.imageMessage?.caption ?? \u0027\u0027).trim();\nreturn [{ json: { isGroup, phone, text, mid: String(data.key?.id ?? \u0027\u0027), instance: String(evt.instance ?? \u0027\u0027), pushName: String(data.pushName ?? \u0027\u0027) } };]"
                                     },
                      "id":  "aaaa1111-0000-4000-8000-000000000002",
