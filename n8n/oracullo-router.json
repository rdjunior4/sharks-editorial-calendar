        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Webhook Oracullo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "oracullo-prospecting"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-worker-secret'] }}",
              "rightValue": "oc_be3f92fca1ec44bfb85e2a75aecaa24d15762ec78c414094af68b1c8a5c09025",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0002-4000-8000-000000000002",
      "name": "Secret OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.type }}",
                    "rightValue": "send_message",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "send_message"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "b1000000-0003-4000-8000-000000000003",
      "name": "Tipo de Job",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prepara o envio: audio (audio_url) ou texto em blocos de 150 caracteres\nconst webhook = $('Webhook Oracullo').first().json;\nconst input = webhook.body.input ?? {};\nconst msg = String(input.message ?? '');\nconst base = { job_id: webhook.body.job_id, channel: input.channel ?? 'whatsapp', to: input.to ?? '' };\nif (input.audio_url) {\n  try {\n    const res = await fetch(String(input.audio_url));\n    if (res.ok) {\n      const buf = Buffer.from(await res.arrayBuffer());\n      return [{ json: { ...base, mode: 'audio', audio: 'data:audio/mpeg;base64,' + buf.toString('base64'), text: msg, part: 1, total: 1 } }];\n    }\n  } catch (e) { /* fallback: envia texto */ }\n}\nconst chunks = [];\nfor (let i = 0; i < msg.length; i += 150) chunks.push(msg.slice(i, i + 150));\nreturn chunks.map((text, i) => ({ json: { ...base, mode: 'text', text, part: i + 1, total: chunks.length } }));"
      },
      "id": "b1000000-0007-4000-8000-000000000007",
      "name": "Preparar Envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=COLE_EVO_AQUI/message/{{ $json.mode === 'audio' ? 'sendAudio' : 'sendText' }}/COLE_INSTANCIA_AQUI",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLE_EVO_KEY_AQUI"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.mode === 'audio' ? { number: String($json.to).replace(/\\D/g, '') + '@s.whatsapp.net', audio: $json.audio } : { number: String($json.to).replace(/\\D/g, '') + '@s.whatsapp.net', text: ($json.total > 1 ? '[' + $json.part + '/' + $json.total + '] ' : '') + $json.text }) }}",
        "options": {}
      },
      "id": "b1000000-0008-4000-8000-000000000008",
      "name": "Evolution WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        340
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const last = $input.item.json;\nconst webhook = $('Webhook Oracullo').first().json;\nconst ok = last.error ? false : true;\nreturn { json: { job_id: webhook.body.job_id, status: ok ? 'completed' : 'failed', error: ok ? null : String(last.error ?? 'Falha no envio WhatsApp'), output: ok ? { channel: 'whatsapp', parts_sent: $('Preparar Envio').all().length } : null } };"
      },
      "id": "b1000000-0009-4000-8000-000000000009",
      "name": "Resultado WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        340
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const webhook = $('Webhook Oracullo').first().json;\nreturn { json: { job_id: webhook.body.job_id, status: 'completed', output: { canal: webhook.body.type, nota: 'Job recebido pelo n8n' } } };"
      },
      "id": "b1000000-0011-4000-8000-000000000011",
      "name": "Default Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Payload do callback + timestamp p/ assinatura (HMAC, janela 5min)\nconst it = $input.item.json;\nconst payload = { job_id: it.job_id, status: it.status, error: it.error ?? null, output: it.output ?? null };\nconst payloadStr = JSON.stringify(payload);\nreturn [{ json: { ts: Math.floor(Date.now() / 1000), payloadStr } }];"
      },
      "id": "b1000000-0020-4000-8000-000000000020",
      "name": "Preparar Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        460
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "secret": "0b60e31b950462dfe9f938072a0ad15802b80f0ea7b02fa5edde6267914dd84a",
        "value": "={{ $json.ts + \".\" + $json.payloadStr }}",
        "encoding": "base64"
      },
      "id": "b1000000-0021-4000-8000-000000000021",
      "name": "Assinar Callback",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        1320,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cyumczehpiiarwqrpgnu.supabase.co/functions/v1/prospecting-job-callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-worker-secret",
              "value": "oc_be3f92fca1ec44bfb85e2a75aecaa24d15762ec78c414094af68b1c8a5c09025"
            },
            {
              "name": "x-signature",
              "value": "=t={{ $('Preparar Callback').item.json.ts }},v={{ $json.data }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Preparar Callback').item.json.payloadStr }}",
        "options": {}
